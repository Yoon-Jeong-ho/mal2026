# Secrets and local Codex/OMX runtime state
.env
.omx/
outputs/
wandb/
.research/

# AI-Hub raw downloads and operational logs (large and/or restricted data)
data/raw/
data/processed/
# Restricted OpenAI Batch requests/responses/mappings/candidates.  This
# explicit rule documents the canonical isolation root in addition to the
# legacy broad processed-data exclusion above.
data/processed/restricted/openai_rationale_batches/
# Restricted GPT-5.6-Luna low-tail diagnostic requests, responses, and row maps.
data/processed/restricted/luna_tail_causal_audit_v1/
data/logs/
eval/

# Downloaded third-party executable; retrieve it through the documented script.
tools/aihubshell

# Python bytecode cache
__pycache__/

# Local project environment; dependencies are reproducible from project specs.
.venv/
.venv-standard/

# Submission images are built from a local runtime bundle containing model
# weights.  Keep the reproducible serving code and bundle instructions tracked,
# but never add the staged checkpoints themselves to Git.
deployment/runtime_bundle/*
!deployment/runtime_bundle/README.md
deployment/runtime_bundle_r0/*
!deployment/runtime_bundle_r0/README.md
deployment/runtime_overlay_r0_best_rationale/*
!deployment/runtime_overlay_r0_best_rationale/README.md

