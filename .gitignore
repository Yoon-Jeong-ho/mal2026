# Secrets and local Codex/OMX runtime state
.env
.omx/
outputs/
wandb/

# AI-Hub raw downloads and operational logs (large and/or restricted data)
data/raw/
data/processed/
# Restricted OpenAI Batch requests/responses/mappings/candidates.  This
# explicit rule documents the canonical isolation root in addition to the
# legacy broad processed-data exclusion above.
data/processed/restricted/openai_rationale_batches/
data/logs/
eval/

# Downloaded third-party executable; retrieve it through the documented script.
tools/aihubshell

# Python bytecode cache
__pycache__/

# Local project environment; dependencies are reproducible from project specs.
.venv/
.venv-standard/

